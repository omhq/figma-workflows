{
  "name": "figma-workflows",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Build reusable, automated workflows inside Figma.",
  "scripts": {
    "build": "npm run build:ui && npm run build:controller",
    "build:ui": "vite build",
    "build:controller": "vite build --config vite.controller.config.ts",
    "predev": "npm run build",
    "dev": "concurrently --kill-others --names ui,controller \"npm:dev:ui\" \"npm:dev:controller\"",
    "dev:ui": "vite build --watch --mode development",
    "dev:controller": "vite build --watch --mode development --config vite.controller.config.ts",
    "start": "npm run dev",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "figma:watch": "modd"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "formik": "^2.4.9",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-sortablejs": "^6.1.4",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@figma/plugin-typings": "^1.134.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sortablejs": "^1.15.9",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
